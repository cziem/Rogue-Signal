{
  "name": "rogue-signal-youtube-mcp-server",
  "version": "1.0.0",
  "description": "YouTube publishing MCP server for the Rogue Signal channel: private-by-default uploads with a human review gate, OAuth for claude.ai custom connectors, stdio for Claude Code.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "rogue-signal-mcp": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "rm -rf dist coverage",
    "start": "node dist/index.js",
    "start:http": "node dist/index.js --http",
    "dev": "tsx watch src/index.ts --http",
    "auth": "node dist/index.js auth",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "check": "npm run lint && npm run typecheck && npm test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cziem/rogue-signal.git"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "youtube",
    "claude",
    "oauth"
  ],
  "author": "George (cziem)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/cziem/rogue-signal/issues"
  },
  "homepage": "https://github.com/cziem/rogue-signal#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "express": "^5.3.0",
    "google-auth-library": "^11.3.0",
    "googleapis": "^186.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/supertest": "^7.2.1",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
