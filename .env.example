# Copy to .env and fill in. Never commit the real .env.

# --- Required in every mode --------------------------------------------------
# Google OAuth client (Google Cloud console > APIs & Services > Credentials).
# HTTP mode: a "Web application" client. stdio mode: a "Desktop app" client is easiest.
GOOGLE_CLIENT_ID=1234567890-abc.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-replace-me

# 32-byte key that encrypts stored tokens at rest. Generate with:
#   openssl rand -base64 32
# Losing or changing it invalidates all stored connections (users must reconnect).
TOKEN_ENCRYPTION_KEY=replace-with-output-of-openssl-rand-base64-32

# Where the encrypted state file lives. Mount a persistent volume here in production.
DATA_DIR=./data

# --- HTTP (remote connector) mode ---------------------------------------------
# Public https origin of this server, no trailing path. The MCP endpoint is $PUBLIC_BASE_URL/mcp
# and the Google redirect URI to register is $PUBLIC_BASE_URL/oauth/google/callback.
PUBLIC_BASE_URL=https://rogue-signal-mcp-xxxxx-uc.a.run.app

# REQUIRED: comma-separated Google accounts allowed to connect. The server will not start without it.
ALLOWED_GOOGLE_EMAILS=you@example.com

# Optional: lock connections to specific YouTube channel IDs (UC...). Recommended.
ALLOWED_CHANNEL_IDS=

# Optional: https origins MCP clients may use as OAuth redirect URIs (default: claude.ai + claude.com).
# OAUTH_ALLOWED_REDIRECT_ORIGINS=https://claude.ai,https://claude.com
# Allow http://localhost / 127.0.0.1 redirect URIs for native clients like Claude Code (default true).
# OAUTH_ALLOW_LOOPBACK_REDIRECTS=true

# PORT=8080
# HOST=0.0.0.0
# ACCESS_TOKEN_TTL_SECONDS=3600
# REFRESH_TOKEN_TTL_SECONDS=2592000
# TRUST_PROXY=true
# LOG_LEVEL=info

# --- stdio (local) mode ---------------------------------------------------------
# Either run `rogue-signal-mcp auth` once (stores an encrypted token in DATA_DIR),
# or provide a refresh token directly:
# GOOGLE_REFRESH_TOKEN=
# Loopback port used by `rogue-signal-mcp auth`:
# LOCAL_AUTH_PORT=53682
